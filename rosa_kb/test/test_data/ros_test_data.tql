insert

$ros_typedb isa LifeCycleNode, has component-name 'ros_typedb_test', has package 'ros_typedb', has executable 'ros_typedb';
$database_name isa ComponentParameter, has parameter-key 'database_name', has parameter-value 'ros_typedb_executor', has parameter-type 'string';
$force_database isa ComponentParameter, has parameter-key 'force_database', has parameter-value 'true', has parameter-type 'boolean';
$force_data isa ComponentParameter, has parameter-key 'force_data', has parameter-value 'false', has parameter-type 'boolean';
$data_path isa ComponentParameter, has parameter-key 'data_path', has parameter-value '[test_data/test_data.tql]', has parameter-type 'string_array';
(component:$ros_typedb, parameter:$database_name, parameter:$force_database, parameter:$force_data, parameter:$data_path) isa component-configuration,
    has component-configuration-name 'ros_typedb_config';

$ros_typedb_2 isa LifeCycleNode, has component-name 'ros_typedb_test_2', has package 'ros_typedb', has executable 'ros_typedb';
$database_name_2 isa ComponentParameter, has parameter-key 'database_name', has parameter-value 'ros_typedb_executor_2', has parameter-type 'string';
$force_database_2 isa ComponentParameter, has parameter-key 'force_database', has parameter-value 'false', has parameter-type 'boolean';
$force_data_2 isa ComponentParameter, has parameter-key 'force_data', has parameter-value 'true', has parameter-type 'boolean';
$data_path_2 isa ComponentParameter, has parameter-key 'data_path', has parameter-value '[test_data/test_data.tql]', has parameter-type 'string_array';
(component:$ros_typedb_2, parameter:$database_name_2, parameter:$force_database_2, parameter:$force_data_2, parameter:$data_path_2) isa component-configuration,
    has component-configuration-name 'ros_typedb_config_2';

$qa_interface_test isa QualityAttribute, has measure-name 'qa_test_topic';
(measure: $qa_interface_test) isa topic-interface,
    has measurement-interface-name '/subscription',
    has measurement-interface-type 'std_msgs/msg/Float64',
    has measurement-function-name 'get_data_field',
    has measurement-function-lib 'rosa_monitor.monitor_functions',
    has measurement-function-args 'data';

$qos_test isa QoSProfile,
	has reliability 'RELIABLE',
	has history 'KEEP_LAST',
	has depth 10,
	has durability 'TRANSIENT_LOCAL',
	has lifespan 2.0,
	has deadline 2.0,
	has liveliness 'MANUAL_BY_TOPIC',
	has lease-duration 2.0;

$qa_interface_test2 isa QualityAttribute, has measure-name 'qa_test_topic_2';
(measure: $qa_interface_test2, qos: $qos_test) isa topic-interface,
    has measurement-interface-name '/subscription2',
    has measurement-interface-type 'std_msgs/msg/Float64';

$sensor_qos isa QoSProfile,
	has reliability 'BEST_EFFORT',
	has history 'KEEP_LAST',
	has depth 5,
	has durability 'VOLATILE',
	has lifespan 0.0,
	has deadline 0.0,
	has liveliness 'SYSTEM_DEFAULT',
	has lease-duration 0.0;
$ea_laser_nearest_object isa EnvironmentalAttribute, has measure-name 'laser_nearest_object';
(measure: $ea_laser_nearest_object, qos: $sensor_qos) isa topic-interface,
    has measurement-interface-name '/scan',
    has measurement-interface-type 'sensor_msgs/msg/LaserScan',
    has measurement-function-name 'get_nearest_scan_distance_in_base',
    has measurement-function-lib 'rosa_monitor.laser_scan_functions';