define

package sub attribute,
    value string;

executable sub attribute,
    value string;

ROSNode sub Component,
    owns package,
    owns executable;

LifeCycleNode sub ROSNode;


### QoS attributes
reliability sub attribute,
    value string,
    regex "^(BEST_EFFORT|RELIABLE)";
history sub attribute,
    value string,
    regex "^(KEEP_LAST|KEEP_ALL|UNKOWN)";
depth sub attribute,
    value long;
durability sub attribute,
    value string,
    regex "^(TRANSIENT_LOCAL|VOLATILE)";
deadline sub attribute,
    value double;  # 0.0 indicates infinite
lifespan sub attribute,
    value double;  # 0.0 indicates infinite
liveliness sub attribute,
    value string,
    regex "^(AUTOMATIC|MANUAL_BY_TOPIC)";
lease-duration sub attribute,
    value double;  # 0.0 indicates infinite

QoSProfile sub entity,
    owns reliability,
    owns history,
    owns depth,
    owns durability,
    owns deadline,
    owns lifespan,
    owns liveliness,
    owns lease-duration,
    plays topic-interface:qos;

### ROS measurement interfaces
rate sub attribute,
    value double;

service-interface sub measurement-interface,
    owns rate;

topic-interface sub measurement-interface,
    relates qos;